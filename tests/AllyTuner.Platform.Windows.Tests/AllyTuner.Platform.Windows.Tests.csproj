<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Smoke tests for the Windows platform layer. They call real Windows APIs, so they RUN only on
    Windows (CI: windows-latest, a non-ASUS machine). They build on the Mac thanks to EnableWindowsTargeting.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit test method names use underscores; CA1707 does not apply here. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AllyTuner.Platform.Windows\AllyTuner.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
