<?xml version="1.0" encoding="utf-8"?>
<!--
  Logo manifest for a packaged build. The app itself stays unpackaged
  (WindowsPackageType is None in AllyTuner.App.csproj), so this file is not
  compiled. Paths are relative to src/AllyTuner.App. Scale-200 and targetsize
  files sit next to the base names and use the Windows qualifier convention.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity
    Name="AllyTuner"
    Publisher="CN=Ally Tuner"
    Version="0.2.0.0" />
  <Properties>
    <DisplayName>Ally Tuner</DisplayName>
    <PublisherDisplayName>Ally Tuner</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Ally Tuner"
        Description="Tunes a ROG Xbox Ally X for plugged-in play."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
