<Page
    x:Class="AllyTuner.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Style="{StaticResource PageStackStyle}">
      <StackPanel.ChildrenTransitions>
        <TransitionCollection>
          <EntranceThemeTransition FromVerticalOffset="28" IsStaggeringEnabled="True" />
        </TransitionCollection>
      </StackPanel.ChildrenTransitions>

      <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" />

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="Dry-run mode" Style="{StaticResource CardLabelTextStyle}" />
          <TextBlock x:Name="DryRunValue" Style="{StaticResource CardValueTextStyle}" />
          <TextBlock
              Style="{StaticResource CardDetailTextStyle}"
              Text="This build cannot change hardware, so dry-run is locked on. Later builds let you turn it off for each control, one at a time, after you have watched its dry-run on the Ally." />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="When another app changes a setting back" Style="{StaticResource CardLabelTextStyle}" />
          <TextBlock
              Style="{StaticResource CardDetailTextStyle}"
              Text="Armoury Crate or AMD Software can change settings Ally Tuner applied. While Ally Tuner is open it checks every 30 seconds. Only settings that were changed live and that Windows or the device can report are checked; for the others, you get a warning while Armoury Crate is running." />
          <TextBlock x:Name="OverrideStatusText" Style="{StaticResource CardDetailTextStyle}" />
          <RadioButtons x:Name="OverridePolicyChoice" SelectionChanged="OverridePolicyChoice_SelectionChanged">
            <RadioButton MinHeight="56" FontSize="16" Content="Warn me and leave it (recommended)" Tag="Warn" />
            <RadioButton MinHeight="56" FontSize="16" Content="Apply my setting again (stops after 3 times in 10 minutes)" Tag="ReApply" />
          </RadioButtons>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="About" Style="{StaticResource CardLabelTextStyle}" />
          <TextBlock x:Name="VersionValue" Style="{StaticResource CardValueTextStyle}" IsTextSelectionEnabled="True" />
          <TextBlock x:Name="DataFolderText" Style="{StaticResource CardDetailTextStyle}" IsTextSelectionEnabled="True" />
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
            <Button Content="Open logs folder" Style="{StaticResource TouchButtonStyle}" Click="OpenLogsButton_Click" />
            <Button Content="Open reports folder" Style="{StaticResource TouchButtonStyle}" Click="OpenReportsButton_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
