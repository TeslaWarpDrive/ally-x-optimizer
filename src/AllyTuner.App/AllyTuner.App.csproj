<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WinUI 3 desktop app. Unpackaged (no MSIX) and self-contained (no separate Windows App SDK or
    .NET runtime install needed on the Ally). Always runs elevated (see app.manifest).
    Builds only on Windows (GitHub Actions windows-latest).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>AllyTuner</RootNamespace>
    <AssemblyName>AllyTuner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Default rule set for the UI project; Core and Platform use the stricter "recommended" set. -->
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AllyTuner.Core\AllyTuner.Core.csproj" />
    <ProjectReference Include="..\AllyTuner.Platform.Windows\AllyTuner.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
