<!--
  Aurora: Ally Tuner's design system, adapted from the Aurora palette in Bradley's design-arsenal
  (ink #0E0D18, surface #17162A, raised #201F36, text #E6EAFB, accent #B4BEFE, teal #4FE3CF,
  violet #B78CFF, pink #F49BDD) for native WinUI 3.

  Rules:
  - The teal -> violet -> pink gradient appears only on the brand mark and the Home hero orb.
    Everything else stays flat, so text stays easy to read on a 7-inch screen.
  - Safety colours are separate from the decoration: amber = dry-run / attention, teal = good,
    coral = failed / destructive. They are never used for decoration.
  - Big targets (56 px buttons, 56 px menu items), body text 15-17 px, numbers in Bahnschrift.
  - Motion uses Fluent theme transitions, which follow Windows' "Animation effects" setting.
  - High contrast keeps the system's own colours: the overrides below are only for the dark theme.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette ===================================================================================== -->
  <Color x:Key="AuroraInk">#FF0E0D18</Color>
  <Color x:Key="AuroraSurface">#FF17162A</Color>
  <Color x:Key="AuroraRaised">#FF201F36</Color>
  <Color x:Key="AuroraRaisedHover">#FF29284A</Color>
  <Color x:Key="AuroraLine">#FF2E2D4D</Color>
  <Color x:Key="AuroraText">#FFE6EAFB</Color>
  <Color x:Key="AuroraMuted">#FFA4A9C8</Color>
  <Color x:Key="AuroraAccent">#FFB4BEFE</Color>
  <Color x:Key="AuroraTeal">#FF4FE3CF</Color>
  <Color x:Key="AuroraViolet">#FFB78CFF</Color>
  <Color x:Key="AuroraPink">#FFF49BDD</Color>
  <Color x:Key="AuroraAmber">#FFFFC857</Color>
  <Color x:Key="AuroraCoral">#FFFF8A8A</Color>

  <SolidColorBrush x:Key="AuroraInkBrush" Color="{StaticResource AuroraInk}" />
  <SolidColorBrush x:Key="AuroraSurfaceBrush" Color="{StaticResource AuroraSurface}" />
  <SolidColorBrush x:Key="AuroraRaisedBrush" Color="{StaticResource AuroraRaised}" />
  <SolidColorBrush x:Key="AuroraLineBrush" Color="{StaticResource AuroraLine}" />
  <SolidColorBrush x:Key="AuroraTextBrush" Color="{StaticResource AuroraText}" />
  <SolidColorBrush x:Key="AuroraMutedBrush" Color="{StaticResource AuroraMuted}" />
  <SolidColorBrush x:Key="AuroraAccentBrush" Color="{StaticResource AuroraAccent}" />
  <SolidColorBrush x:Key="AuroraTealBrush" Color="{StaticResource AuroraTeal}" />
  <SolidColorBrush x:Key="AuroraAmberBrush" Color="{StaticResource AuroraAmber}" />
  <SolidColorBrush x:Key="AuroraCoralBrush" Color="{StaticResource AuroraCoral}" />

  <!-- Status: the only colours that carry meaning. -->
  <SolidColorBrush x:Key="StatusGoodBrush" Color="{StaticResource AuroraTeal}" />
  <SolidColorBrush x:Key="StatusAttentionBrush" Color="{StaticResource AuroraAmber}" />
  <SolidColorBrush x:Key="StatusProblemBrush" Color="{StaticResource AuroraCoral}" />
  <SolidColorBrush x:Key="StatusNeutralBrush" Color="{StaticResource AuroraMuted}" />
  <SolidColorBrush x:Key="DryRunSurfaceBrush" Color="#26FFC857" />
  <SolidColorBrush x:Key="DryRunBorderBrush" Color="#8CFFC857" />

  <!-- The one gradient, for the brand mark and the hero orb only. -->
  <LinearGradientBrush x:Key="AuroraGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="{StaticResource AuroraTeal}" />
    <GradientStop Offset="0.45" Color="#FF8E9BFF" />
    <GradientStop Offset="0.8" Color="{StaticResource AuroraViolet}" />
    <GradientStop Offset="1" Color="{StaticResource AuroraPink}" />
  </LinearGradientBrush>

  <!-- Card surface: raised ink with a light top edge, like light catching glass. -->
  <SolidColorBrush x:Key="CardSurfaceBrush" Color="#E61B1A2F" />
  <LinearGradientBrush x:Key="CardEdgeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#38FFFFFF" />
    <GradientStop Offset="0.35" Color="#14FFFFFF" />
    <GradientStop Offset="1" Color="#0AFFFFFF" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroEdgeBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#804FE3CF" />
    <GradientStop Offset="0.5" Color="#408E9BFF" />
    <GradientStop Offset="1" Color="#60F49BDD" />
  </LinearGradientBrush>

  <!-- Type ======================================================================================== -->
  <!-- Bahnschrift (a DIN face that ships with Windows) for titles and numbers; Segoe UI Variable for text. -->
  <FontFamily x:Key="DisplayFontFamily">Bahnschrift</FontFamily>
  <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>

  <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="LineHeight" Value="44" />
    <Setter Property="Foreground" Value="{StaticResource AuroraTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="34" />
    <Setter Property="Foreground" Value="{StaticResource AuroraTextBrush}" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="Foreground" Value="{StaticResource AuroraTextBrush}" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>

  <Style x:Key="BodyLargeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="25" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource AuroraTextBrush}" />
  </Style>

  <!-- Big numbers: watts, temperatures, percentages. -->
  <Style x:Key="MetricTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="48" />
    <Setter Property="LineHeight" Value="52" />
    <Setter Property="Foreground" Value="{StaticResource AuroraTextBrush}" />
  </Style>

  <Style x:Key="CardLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource AuroraMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="CardValueTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="Foreground" Value="{StaticResource AuroraTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="CardDetailTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource AuroraMutedBrush}" />
  </Style>

  <Style x:Key="MonoDetailTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource AuroraMutedBrush}" />
  </Style>

  <!-- Surfaces ==================================================================================== -->
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="24,20" />
  </Style>

  <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
    <Setter Property="BorderBrush" Value="{StaticResource HeroEdgeBrush}" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="32,28" />
  </Style>

  <!-- Small rounded label with a coloured dot, for status at a glance. Set the dot's Fill in code or XAML. -->
  <Style x:Key="ChipStyle" TargetType="Border">
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,5" />
  </Style>

  <Style x:Key="ChipTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource AuroraTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Buttons ===================================================================================== -->
  <!-- A thick periwinkle focus ring, easy to follow from arm's length with a controller. -->
  <Style x:Key="TouchButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="MinWidth" Value="180" />
    <Setter Property="Padding" Value="24,12" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="FocusVisualPrimaryThickness" Value="3" />
    <Setter Property="FocusVisualSecondaryThickness" Value="1" />
    <Setter Property="FocusVisualMargin" Value="-4" />
  </Style>

  <Style x:Key="TouchAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="MinWidth" Value="180" />
    <Setter Property="Padding" Value="24,12" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="FocusVisualPrimaryThickness" Value="3" />
    <Setter Property="FocusVisualSecondaryThickness" Value="1" />
    <Setter Property="FocusVisualMargin" Value="-4" />
  </Style>

  <!-- Confirmation dialog buttons: 56 px like every other control. The default (Cancel) keeps the accent fill. -->
  <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="FocusVisualPrimaryThickness" Value="3" />
    <Setter Property="FocusVisualSecondaryThickness" Value="1" />
  </Style>

  <Style x:Key="DialogDefaultButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="FocusVisualPrimaryThickness" Value="3" />
    <Setter Property="FocusVisualSecondaryThickness" Value="1" />
  </Style>

  <!-- Page layout: the same padding and width everywhere. Each page adds its own staggered entrance. -->
  <Style x:Key="PageStackStyle" TargetType="StackPanel">
    <Setter Property="Padding" Value="36,24,36,40" />
    <Setter Property="Spacing" Value="20" />
    <Setter Property="MaxWidth" Value="1120" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
</ResourceDictionary>
