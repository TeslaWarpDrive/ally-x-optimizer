<Window
    x:Class="AllyTuner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ally Tuner">

  <!-- Aurora: ink background with two soft, static glows. Drawn once; nothing here animates. -->
  <Grid x:Name="RootGrid" Background="{StaticResource AuroraInkBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.Resources>
      <!-- The dry-run dot breathes slowly. Started only when Windows animation effects are on. -->
      <Storyboard x:Key="DryRunPulse" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetName="DryRunDot" Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1.4">
          <DoubleAnimation.EasingFunction>
            <SineEase EasingMode="EaseInOut" />
          </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
      </Storyboard>
    </Grid.Resources>

    <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush Center="0.92,0.02" GradientOrigin="0.92,0.02" RadiusX="0.55" RadiusY="0.75">
          <GradientStop Offset="0" Color="#2E4FE3CF" />
          <GradientStop Offset="0.55" Color="#108E9BFF" />
          <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush Center="0.35,1.05" GradientOrigin="0.35,1.05" RadiusX="0.6" RadiusY="0.55">
          <GradientStop Offset="0" Color="#26B78CFF" />
          <GradientStop Offset="0.6" Color="#0AF49BDD" />
          <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- Custom title bar: the brand mark sits where the system title would be. -->
    <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,0,0,0" VerticalAlignment="Center">
        <Ellipse Width="18" Height="18" Fill="{StaticResource AuroraGradientBrush}" />
        <TextBlock Text="Ally Tuner" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource AuroraTextBrush}" VerticalAlignment="Center" />
        <TextBlock x:Name="TitleVersionText" FontSize="12" Foreground="{StaticResource AuroraMutedBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Pane is always open: no hidden hamburger menu to hunt for on a handheld. -->
    <NavigationView
        x:Name="Nav"
        Grid.Row="1"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="True"
        IsTitleBarAutoPaddingEnabled="False"
        OpenPaneLength="272"
        XYFocusKeyboardNavigation="Enabled"
        Loaded="Nav_Loaded"
        SelectionChanged="Nav_SelectionChanged"
        ItemInvoked="Nav_ItemInvoked"
        PreviewKeyDown="Root_PreviewKeyDown"
        PreviewKeyUp="Root_PreviewKeyUp">
        <NavigationView.MenuItems>
          <NavigationViewItem Content="Home" Tag="home">
            <NavigationViewItem.Icon>
              <FontIcon Glyph="&#xE80F;" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem Content="Power" Tag="power">
            <NavigationViewItem.Icon>
              <FontIcon Glyph="&#xE945;" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem Content="Graphics" Tag="graphics">
            <NavigationViewItem.Icon>
              <FontIcon Glyph="&#xE7F4;" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem Content="Windows tweaks" Tag="windows">
            <NavigationViewItem.Icon>
              <FontIcon Glyph="&#xE90F;" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem Content="Battery" Tag="battery">
            <NavigationViewItem.Icon>
              <FontIcon Glyph="&#xE83F;" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem Content="Profiles" Tag="profiles">
            <NavigationViewItem.Icon>
              <FontIcon Glyph="&#xE8FD;" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem Content="Safety and changes" Tag="safety">
            <NavigationViewItem.Icon>
              <FontIcon Glyph="&#xE83D;" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem Content="Hardware probe" Tag="probe">
            <NavigationViewItem.Icon>
              <FontIcon Glyph="&#xE9D9;" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- Always one press away: invoking it opens the confirmation; it never navigates. -->
        <NavigationView.FooterMenuItems>
          <NavigationViewItem x:Name="ResetNavItem" Content="Reset to Safe Defaults" Tag="reset" SelectsOnInvoked="False">
            <NavigationViewItem.Icon>
              <FontIcon Glyph="&#xE777;" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
        </NavigationView.FooterMenuItems>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          The dry-run banner cannot be closed: while it shows, nothing on the device is changed.
          Amber is reserved for this and for warnings, so it never blends into the decoration.
        -->
        <Border
            x:Name="DryRunBanner"
            Grid.Row="0"
            Margin="36,16,36,0"
            MaxWidth="1048"
            Padding="20,12"
            CornerRadius="16"
            Background="{StaticResource DryRunSurfaceBrush}"
            BorderBrush="{StaticResource DryRunBorderBrush}"
            BorderThickness="1">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="14" Height="14" VerticalAlignment="Center">
              <Ellipse Fill="{StaticResource AuroraAmberBrush}" Opacity="0.25" Width="14" Height="14" />
              <Ellipse x:Name="DryRunDot" Fill="{StaticResource AuroraAmberBrush}" Width="8" Height="8" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Dry-run" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="SemiBold" FontSize="18" Foreground="{StaticResource AuroraAmberBrush}" />
              <TextBlock
                  Text="Nothing on this device is changed. Every change is simulated and recorded in the change log."
                  FontSize="15"
                  TextWrapping="Wrap"
                  Foreground="{StaticResource AuroraTextBrush}" />
            </StackPanel>
            <!-- TouchButtonStyle: 56 px and the same 3 px focus ring as every other button. -->
            <Button
                Grid.Column="2"
                Content="Open change log"
                Style="{StaticResource TouchButtonStyle}"
                MinWidth="0"
                VerticalAlignment="Center"
                Click="OpenChangeLog_Click" />
          </Grid>
        </Border>

        <!-- Shown when the override check finds that another app changed a setting back. -->
        <InfoBar
            x:Name="OverrideBanner"
            Grid.Row="1"
            Margin="36,10,36,0"
            MaxWidth="1048"
            IsOpen="False"
            IsClosable="True"
            Severity="Warning"
            Title="Another app changed a setting" />

        <Frame x:Name="ContentFrame" Grid.Row="2" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
