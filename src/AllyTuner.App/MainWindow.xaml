<Window
    x:Class="AllyTuner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ally Tuner">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <!-- Pane is always open: no hidden hamburger menu to hunt for on a handheld. -->
  <NavigationView
      x:Name="Nav"
      PaneDisplayMode="Left"
      IsBackButtonVisible="Collapsed"
      IsPaneToggleButtonVisible="False"
      IsSettingsVisible="True"
      OpenPaneLength="260"
      XYFocusKeyboardNavigation="Enabled"
      Loaded="Nav_Loaded"
      SelectionChanged="Nav_SelectionChanged"
      ItemInvoked="Nav_ItemInvoked"
      PreviewKeyDown="Root_PreviewKeyDown"
      PreviewKeyUp="Root_PreviewKeyUp">
    <NavigationView.MenuItems>
      <NavigationViewItem Content="Home" Tag="home">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE80F;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="Power" Tag="power">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE945;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="Graphics" Tag="graphics">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE7F4;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="Windows tweaks" Tag="windows">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE90F;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="Battery" Tag="battery">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE83F;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="Profiles" Tag="profiles">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE8FD;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="Safety and changes" Tag="safety">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE83D;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="Hardware probe" Tag="probe">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE9D9;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.MenuItems>

    <!-- Always one press away: invoking it opens the confirmation; it never navigates. -->
    <NavigationView.FooterMenuItems>
      <NavigationViewItem x:Name="ResetNavItem" Content="Reset to Safe Defaults" Tag="reset" SelectsOnInvoked="False">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE777;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.FooterMenuItems>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- The dry-run banner cannot be closed: while it shows, nothing on the device is changed. -->
      <InfoBar
          x:Name="DryRunBanner"
          Grid.Row="0"
          Margin="16,12,16,0"
          IsOpen="True"
          IsClosable="False"
          Severity="Warning"
          Title="Dry-run"
          Message="Nothing on this device is changed. Every change is simulated and recorded in the change log.">
        <InfoBar.ActionButton>
          <Button Content="Open change log" MinHeight="44" Click="OpenChangeLog_Click" />
        </InfoBar.ActionButton>
      </InfoBar>

      <!-- Shown when the override check finds another app changed a setting back. -->
      <InfoBar
          x:Name="OverrideBanner"
          Grid.Row="1"
          Margin="16,8,16,0"
          IsOpen="False"
          IsClosable="True"
          Severity="Warning"
          Title="Another app changed a setting" />

      <Frame x:Name="ContentFrame" Grid.Row="2" />
    </Grid>
  </NavigationView>
</Window>
