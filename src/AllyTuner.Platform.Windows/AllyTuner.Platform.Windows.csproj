<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows-only code that talks to the OS. Phase 1 is strictly read-only: documented Microsoft APIs
    (WMI, power, DXGI, gaming experience) and DSTS reads of the ASUS ATKACPI driver. Writes arrive in
    later phases behind the safety framework.
    EnableWindowsTargeting lets this project compile (not run) on macOS for a quick local check.
    AllowUnsafeBlocks: source-generated P/Invoke (LibraryImport) and COM vtable calls for DXGI.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>AllyTuner.Platform.Windows</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AllyTuner.Core\AllyTuner.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AllyTuner.Platform.Windows.Tests" />
  </ItemGroup>
</Project>
