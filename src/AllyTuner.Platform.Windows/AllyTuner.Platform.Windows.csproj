<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows-only code that talks to the OS. Phase 0 is strictly read-only and uses only standard,
    documented Microsoft WMI classes. ASUS-specific interfaces arrive in Phase 1 (read) and Phase 4
    (write) behind the safety framework.
    EnableWindowsTargeting lets this project compile (not run) on macOS for a quick local check.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>AllyTuner.Platform.Windows</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AllyTuner.Core\AllyTuner.Core.csproj" />
  </ItemGroup>
</Project>
